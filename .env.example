# StockCurve reads only these public variables. Do not put private keys here.

# --- Devnet (default demo) ---
# Header default on first visit. The in-app network switch overrides this in the browser.
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Devnet RPC used when the header says devnet.
# https://api.devnet.solana.com is public and rate limited. A Helius/Triton/etc devnet URL is more reliable for a live demo.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# --- Mainnet (live listings) ---
# To launch on mainnet:
# 1. Set NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
# 2. Set NEXT_PUBLIC_MAINNET_RPC_URL to your own mainnet endpoint
# 3. Restart `npm run dev`
# 4. In the header, select mainnet-beta
# 5. In the launch wizard, choose the keeper profile (10 SOL or 750 USDC) so Meteora keepers can migrate the pool
# Sandbox thresholds still create a real mainnet pool, but keepers ignore them.
NEXT_PUBLIC_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# --- Paid presets ---
# Leave unset or false. Prime Book stays locked and explains the payment extension.
# Set to true only for a judge walkthrough. The UI will say no SOL was collected.
# NEXT_PUBLIC_DEMO_UNLOCK_PAID_PRESETS=false

# Optional backend a future PresetAccessProvider can call after a real payment.
# StockCurve does not call this URL today.
# PRESET_PAYMENT_WEBHOOK_URL=
