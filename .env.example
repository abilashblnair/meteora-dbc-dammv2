# Default cluster for the desk. Use devnet until you intend to spend mainnet funds.
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Public RPC endpoints. Replace with your own provider. Do not commit API keys.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# Optional hook for a future paid-preset backend. Leave empty.
# A PresetAccessProvider should call this only after a real payment settles.
PRESET_PAYMENT_WEBHOOK_URL=
